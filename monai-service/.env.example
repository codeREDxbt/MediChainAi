# MONAI Service — Environment Variables (example)
# Copy this to `.env` and fill in your values before running the service.

# FastAPI port (default: 8000)
PORT=8000

# Hot-reload in development (set to false in production)
RELOAD=true

# Pre-load the default CT bundle at startup (recommended for production)
MONAI_PRELOAD_MODEL=true

# If calling from a custom Next.js host (for CORS), set this:
NEXTJS_ORIGIN=http://localhost:3000
