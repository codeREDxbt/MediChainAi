# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# JWT Secret (generate a secure random string)
JWT_SECRET="your-jwt-secret-key"

# Database (for Prisma - not actively used)
DATABASE_URL="postgresql://user:password@localhost:5432/database"

# HuggingFace API (for AI Analysis)
HUGGINGFACE_API_KEY="hf_your-huggingface-key"

# OpenRouter API (for Vision AI Analysis)
OPENROUTER_API_KEY="sk-or-v1_your-openrouter-key"

# Solana Configuration (for token minting on devnet)
# Generate admin key: solana-keygen new -o admin-key.json (then convert to base58)
SOLANA_ADMIN_PRIVATE_KEY=""
NEXT_PUBLIC_MCI_TOKEN_MINT=""

# App URL for SEO/meta tags
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MONAI Inference Microservice URL (run monai-service/main.py locally on port 8000)
MONAI_SERVICE_URL="http://localhost:8000"

# Shared secret used by /api/ai/monai -> monai-service /analyze calls
# Required for production remote deployment; keep unset only for local quick testing.
MONAI_SHARED_SECRET="change-this-long-random-secret"
