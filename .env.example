# Copy this file to `.env.local` for local development.

# MONAI service
MONAI_SERVICE_URL=http://localhost:8000
MONAI_SHARED_SECRET=generate-a-long-random-secret
PYTHON_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Auth
JWT_SECRET=generate-a-long-random-jwt-secret
JWT_SECRET_DEV_FALLBACK=dev-only-local-secret

# Optional OpenRouter narrative analysis
OPENROUTER_API_KEY=

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional rewards
SOLANA_ADMIN_PRIVATE_KEY=
NEXT_PUBLIC_MCI_TOKEN_MINT=
